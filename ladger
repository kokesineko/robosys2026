import sys

income = 0
expense = 0

for line in sys.stdin:
  value = float(line.rstrip())

  if value >= 0:
    income += value
  else:
    expense += abs(value)

  balance = income - expense

print(f"収入合計: {income}")
print(f"支出合計: {expense}")
print(f"残高: {balance}")
